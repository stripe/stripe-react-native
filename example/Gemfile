source 'https://rubygems.org'

# You may use http://rbenv.org/ or https://rvm.io/ to install and use this version
ruby ">= 2.6.10"

# Matches COCOAPODS in ios/Podfile.lock. No Gemfile.lock is committed, so this
# pin keeps `bundle exec pod` on the same release. CocoaPods 1.16.2 needs
# xcodeproj >= 1.27; the old xcodeproj < 1.26 pin held CocoaPods at 1.15.2,
# which needs kconv (gone from Ruby 3.4).
gem 'cocoapods', '~> 1.16.2'
# Exclude problematic versions of activesupport that cause build failures.
gem 'activesupport', '>= 6.1.7.5', '!= 7.1.0'
gem 'concurrent-ruby', '< 1.3.4'
# react-native-test-app's test_app.rb calls JSON.fast_generate, removed in
# json 3; algoliasearch (via cocoapods-core) otherwise resolves json 3.
gem 'json', '< 3'

# Ruby 3.4.0 has removed some libraries from the standard library.
gem 'bigdecimal'
gem 'logger'
gem 'benchmark'
gem 'mutex_m'
