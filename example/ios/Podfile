# Podfile for the example app, which doubles as the SDK's iOS test harness.
# The app itself is generated by react-native-test-app (see
# https://github.com/microsoft/react-native-test-app); this file mostly
# configures how the stripe-react-native pod and its Stripe iOS SDK
# dependency are resolved, and wires the SDK's native unit tests into the
# generated project.

# Locate react-native-test-app's Podfile helper by walking up from this
# directory until we find a node_modules that contains it (handles hoisted
# and non-hoisted installs).
ws_dir = Pathname.new(__dir__)
ws_dir = ws_dir.parent until
  File.exist?("#{ws_dir}/node_modules/react-native-test-app/test_app.rb") ||
  ws_dir.expand_path.to_s == '/'
require "#{ws_dir}/node_modules/react-native-test-app/test_app.rb"

workspace 'example.xcworkspace'

# By default the Stripe iOS SDK is resolved through Swift Package Manager
# (see stripe_spm.rb at the repo root). Set STRIPE_DISABLE_SPM=1 to exercise
# the CocoaPods fallback path instead — useful for verifying that apps which
# opt out (or that run React Native < 0.75) still build.
disable_spm = ENV['STRIPE_DISABLE_SPM'] == '1'
$StripeDisableSPM = true if disable_spm

# SPM resolution requires dynamic frameworks: the Stripe Swift package
# products use automatic linkage, which only reaches the final app correctly
# when the pod that consumes them is a dynamic framework (stripe_spm.rb
# enforces this with an actionable error). The CocoaPods fallback keeps
# React Native's default static libraries.
use_frameworks! :linkage => :dynamic unless disable_spm

new_arch_enabled = ENV['NEW_ARCH_ENABLED'].nil? ? true : ENV['NEW_ARCH_ENABLED'] == 'true'

# React Native ships two independent prebuilt mechanisms, and this example
# uses them selectively:
#
# - RCT_USE_RN_DEP (prebuilt third-party dependencies: folly, glog, fmt,
#   boost, ... delivered as ReactNativeDependencies.xcframework) is used on
#   BOTH architectures. Building these from source is not viable under newer
#   Xcodes — e.g. the pinned fmt fails to compile with Xcode 26's Clang
#   (consteval errors) — and as a vendored framework its linkage propagates
#   to dependent pods through standard CocoaPods behavior.
#
# - RCT_USE_PREBUILT_RNCORE (prebuilt React core, React.xcframework via the
#   React-Core-prebuilt pod) is used everywhere EXCEPT old-arch dynamic-
#   frameworks builds. The prebuilt core only wires framework linkage through
#   the new-architecture dependency path, so with dynamic frameworks old-arch
#   pods (e.g. react-native-safe-area-context) compile against prebuilt React
#   headers but never link the framework, failing with undefined RCT*
#   symbols. Static builds (the fallback mode) don't per-pod link, so the
#   prebuilt core is fine there on either architecture.
#
# Note that old-arch + dynamic frameworks (i.e. old arch + SPM mode) is not a
# combination CI exercises: even with a source-built React core, react-native-
# test-app's own DevSupport pod under-declares its React dependencies for
# per-pod linking (undefined facebook::jsi::* symbols), so the harness can't
# build it. CI runs the old-arch jobs with STRIPE_DISABLE_SPM=1 instead,
# which also keeps the CocoaPods fallback path continuously covered. The SPM
# resolution mechanism itself is architecture-independent and is covered by
# the new-arch jobs.
use_prebuilt_rncore = new_arch_enabled || disable_spm
ENV['RCT_USE_RN_DEP'] = '1'
ENV['RCT_USE_PREBUILT_RNCORE'] = '1' if use_prebuilt_rncore

options = {
  :bridgeless_enabled => new_arch_enabled,
  :fabric_enabled =>  new_arch_enabled,
  :hermes_enabled => true,
  # react-native-test-app runs this lambda from its own post_install hook.
  :post_install => lambda do |installer|
    # Only needed for the full-prebuilt (new arch) dynamic-frameworks
    # configuration; with a source-built React core, CocoaPods links the
    # React frameworks into DevSupport through normal pod dependencies. With
    # static libraries (fallback mode) there is no per-framework linking at
    # all. Note the prebuilt framework names below don't exist in those other
    # configurations, so force-linking them there would itself break the
    # build.
    next if disable_spm || !use_prebuilt_rncore

    # react-native-test-app's DevSupport pod doesn't declare linkage against
    # the prebuilt React frameworks, which the dynamic-frameworks build needs
    # (each dynamic framework must resolve its own symbols at link time).
    # Append the missing `-framework` flags to its generated xcconfigs.
    Dir.glob("#{installer.sandbox.root}/Target Support Files/ReactTestApp-DevSupport/*.xcconfig").each do |path|
      lines = File.readlines(path, chomp: true)
      index = lines.index { |line| line.start_with?('OTHER_LDFLAGS =') }
      values = index ? lines[index].split(' = ', 2).last.split(' ') : ['$(inherited)']
      ['React', 'ReactNativeDependencies', 'hermes'].each do |framework|
        quoted_framework = "\"#{framework}\""
        next if values.include?(quoted_framework)

        values << '-framework'
        values << quoted_framework
      end
      line = "OTHER_LDFLAGS = #{values.join(' ')}"
      index ? lines[index] = line : lines << line
      File.write(path, "#{lines.join("\n")}\n")
    end
  end,
}

use_test_app! options do |_target|
  pod 'stripe-react-native', path: '../node_modules/@stripe/stripe-react-native'
  pod 'stripe-react-native/Onramp', path: '../node_modules/@stripe/stripe-react-native'

  # Declares the ReactTestAppTests target so CocoaPods integrates it (search
  # paths etc.); its test sources are added in post_integrate below. The
  # SDK's podspec test_spec isn't used here because test specs build inside
  # the Pods project, where the SPM-resolved Stripe modules aren't visible to
  # a separate test target the way they are to an app-level one.
  _target.tests
end

# post_integrate runs after CocoaPods has written its projects and hooked
# them into the workspace. react-native-test-app regenerates
# ReactTestApp.xcodeproj under node_modules/.generated on every pod install,
# so every adjustment here must be (re)applied on each run.
post_integrate do |_installer|
  project_path = "#{ws_dir}/node_modules/.generated/ios/ReactTestApp.xcodeproj"
  project = Xcodeproj::Project.open(project_path)
  test_target = project.targets.find { |target| target.name == 'ReactTestAppTests' }
  app_target = project.targets.find { |target| target.name == 'ReactTestApp' }

  # The SDK's public headers import React headers non-modularly; when the
  # workspace builds with dynamic frameworks those imports land inside
  # framework modules and Xcode rejects them without this setting.
  [app_target, test_target].compact.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
    end
  end

  # Strip react-native-test-app's single-app-mode compilation flag so the app
  # always uses the standard ReactTestApp launch flow, which is what the e2e
  # harness drives.
  app_target&.build_configurations&.each do |config|
    flags = Array(config.build_settings['OTHER_SWIFT_FLAGS']).flat_map { |flag| flag.to_s.split(' ') }
    flags.delete('-DENABLE_SINGLE_APP_MODE')
    config.build_settings['OTHER_SWIFT_FLAGS'] = flags
  end

  # The SDK's native unit tests live in the repo (ios/Tests), not in the
  # generated test app; add them to the ReactTestAppTests target by reference
  # so `xcodebuild test -scheme ReactTestApp` runs them.
  tests_group = project.main_group.find_subpath('StripeReactNativeTests', true)
  tests_group.path = '../../../../ios/Tests'
  tests_group.source_tree = 'SOURCE_ROOT'

  Dir.glob("#{ws_dir.parent}/ios/Tests/*.{m,swift}").sort.each do |path|
    name = File.basename(path)
    file_ref = tests_group.files.find { |file| file.path == name } || tests_group.new_file(name)
    next if test_target.source_build_phase.files_references.include?(file_ref)

    test_target.add_file_references([file_ref])
  end

  test_target.build_configurations.each do |config|
    flags = Array(config.build_settings['OTHER_SWIFT_FLAGS'] || '$(inherited)')
    flags = flags.flat_map { |flag| flag.to_s.split(' ') }
    flags << '$(inherited)' unless flags.include?('$(inherited)')
    # The tests conditionally compile new-architecture code paths.
    flags << '-DRCT_NEW_ARCH_ENABLED' if new_arch_enabled && !flags.include?('-DRCT_NEW_ARCH_ENABLED')
    unless disable_spm
      # The tests import Stripe modules directly (@testable-importing the SDK
      # framework also requires resolving the modules its Swift interface
      # references). When Stripe is built by SPM inside the Pods project,
      # Xcode generates clang module maps for the package targets under
      # OBJROOT/GeneratedModuleMaps, but nothing puts them on the *test*
      # target's search paths — pod targets get that wiring from React
      # Native's SPM integration, external targets don't. Point the compiler
      # at each generated module map explicitly. (This is also why these
      # flags live here and not in the shipped podspec: app code doesn't
      # import Stripe modules, so regular apps don't need them.)
      %w[
        Stripe Stripe3DS2 StripeApplePay StripeCameraCore StripeCore
        StripeCryptoOnramp StripeFinancialConnections StripeIdentity
        StripeIssuing StripePaymentSheet StripePayments StripePaymentsUI
        StripeUICore
      ].each do |module_name|
        map_flag = "-fmodule-map-file=$(OBJROOT)/GeneratedModuleMaps$(EFFECTIVE_PLATFORM_NAME)/#{module_name}.modulemap"
        next if flags.include?(map_flag)

        flags << '-Xcc'
        flags << map_flag
      end
    end
    config.build_settings['OTHER_SWIFT_FLAGS'] = flags
  end

  project.save
end
