{
  "method": "OnrampSdk.attachKycInfo",
  "description": "KYC details with only a first name. Both KYC mappers leave the missing date of birth, address, and nationalities empty.",
  "input": {
    "kycInfo": { "firstName": "Jenny" }
  },
  "expect": {
    "shared": {
      "kycInfo.firstName": "Jenny",
