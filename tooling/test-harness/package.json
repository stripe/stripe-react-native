{
  "name": "@stripe/react-native-test-harness",
  "version": "0.0.0",
  "private": true,
  "description": "Coverage test harness app. Runs the SDK's native code under react-native-coverage. Never published.",
  "scripts": {
    "lint": "yarn run -T eslint --ignore-path ../../.gitignore --no-error-on-unmatched-pattern \"**/*.{js,ts,tsx}\"",
    "test": "node --test \"scripts/__tests__/*.test.mjs\"",
    "typecheck": "yarn run -T tsc --noEmit -p .",
    "coverage:jest": "yarn test && node scripts/jest-coverage.mjs",
    "coverage:floors:update": "node scripts/jest-coverage.mjs --update",
    "coverage:ios": "bash scripts/run-native-coverage.sh ios",
    "coverage:android": "bash scripts/run-native-coverage.sh android",
    "coverage:assert": "bash scripts/assert-coverage.sh",
    "pods": "pod install --project-directory=ios"
  },
  "dependencies": {
    "@stripe/stripe-react-native": "workspace:*",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-coverage": "0.2.3"
  },
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@babel/runtime": "^7.26.9",
    "@react-native-community/cli": "^20.2.0",
    "@react-native-community/cli-platform-android": "^20.2.0",
    "@react-native-community/cli-platform-ios": "^20.2.0",
    "@react-native/babel-preset": "catalog:",
    "@react-native/metro-config": "^0.81.0",
    "babel-plugin-istanbul": "^7.0.1",
    "react-native-test-app": "patch:react-native-test-app@npm%3A4.4.12#~/.yarn/patches/react-native-test-app-npm-4.4.12-dynamic-framework-deps.patch"
  }
}
