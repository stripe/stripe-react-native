{
  "name": "@stripe/stripe-react-native",
  "version": "0.85.1",
  "private": true,
  "workspaces": [
    "packages/*",
    "tooling/*",
    "examples/*"
  ],
  "author": "Stripe",
  "description": "Stripe SDK for React Native",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "typescript": "yarn typecheck",
    "lint": "eslint \"**/*.{js,ts,tsx}\" --ignore-pattern \"docs/api-reference/*\" --ignore-pattern \"packages/*\" --ignore-pattern \"tooling/*\" --ignore-pattern \"examples/*\" --ignore-path .gitignore",
    "build": "bob build && rm -rf lib/*/package.json",
    "pack": "yarn pack",
    "prepare": "yarn build && husky",
    "propose": "./scripts/propose.rb",
    "release": "./scripts/publish.rb",
    "example": "yarn --cwd example",
    "pods": "cd example && npx pod-install --quiet",
    "update-pods": "cd example/ios && pod update Stripe StripeApplePay StripeFinancialConnections StripePayments StripePaymentSheet StripePaymentsUI StripeCore StripeUICore StripeCryptoOnramp",
    "bootstrap": "yarn example && yarn && yarn prepare && yarn pods",
    "bootstrap-no-pods": "yarn example && yarn && yarn prepare",
    "docs": "yarn typedoc ./src/index.tsx --out ./docs/api-reference --tsconfig ./tsconfig.json --readme none --sort source-order --excludeInternal",
    "run-example-ios": "bash -c 'cd example && yarn ios --simulator \"${IOS_SIMULATOR:-iPhone 16 Pro Max}\"'",
    "run-example-ios:release": "bash -c 'cd example && yarn build:ios && yarn ios --mode Release --simulator \"${IOS_SIMULATOR:-iPhone 16 Pro Max}\" --no-packager'",
    "run-example-android": "bash -c 'cd example && if [ -n \"${ANDROID_SERIAL:-}\" ]; then yarn android --device \"$ANDROID_SERIAL\"; else yarn android; fi'",
    "run-example-android:release": "bash -c 'cd example && yarn build:android && if [ -n \"${ANDROID_SERIAL:-}\" ]; then yarn android --mode=release --no-packager --device \"$ANDROID_SERIAL\"; else yarn android --mode=release --no-packager; fi'",
    "test:e2e:ios": "bash ./scripts/run-maestro-tests ios",
    "test:e2e:android": "bash ./scripts/run-maestro-tests android",
    "test:unit:ios": "bash -c 'xcodebuild test -workspace example/ios/example.xcworkspace -destination \"platform=iOS Simulator,name=${IOS_SIMULATOR:-iPhone 16 Pro Max}\" -scheme ReactTestApp -only-testing:ReactTestAppTests'",
    "test:unit:android": "cd example/android && ./gradlew :stripe_stripe-react-native:testDebugUnitTest",
    "test-ios": "maestro test -e APP_ID=com.stripe.react.native",
    "test-android": "maestro test -e APP_ID=com.stripe.react.native",
    "format:android:check": "cd android && ./gradlew detekt",
    "format:android:write": "cd android && ./gradlew detektFormat",
    "lint:android": "cd android && ./gradlew detekt",
    "format:ios:check": "swiftlint ios --config .swiftlint.yml --strict",
    "format:ios:write": "./scripts/format-changed-ios",
    "test:package-types": "attw --pack .",
    "prepublishOnly": "echo \"\\nPlease use ./scripts/publish instead\\n\" && exit 1",
    "api-extractor:update": "bob build && api-extractor run --local --verbose",
    "api-extractor:check": "bob build && api-extractor run --verbose"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "jest",
    "stripe-react-native.podspec",
    "stripe_spm.rb",
    "app.plugin.js",
    "LICENSE",
    "!android/.cxx",
    "!android/.gradle",
    "!android/build",
    "!android/src/androidTest*",
    "!android/src/test*",
    "!android/src/sharedTest*",
    "!android/lint-rules",
    "!ios/build",
    "!ios/Tests",
    "!ios/**/Tests",
    "!ios/**/Test",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": "https://github.com/stripe/stripe-react-native",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/stripe/stripe-react-native/issues"
  },
  "homepage": "https://github.com/stripe/stripe-react-native/#readme",
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@expo/config-plugins": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@react-native/babel-preset": "catalog:",
    "@react-native/eslint-config": "catalog:",
    "@testing-library/react-hooks": "catalog:",
    "@testing-library/react-native": "catalog:",
    "@types/jest": "catalog:",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "husky": "catalog:",
    "jest": "catalog:",
    "lint-staged": "catalog:",
    "nx": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-builder-bob": "catalog:",
    "react-native-webview": "catalog:",
    "react-test-renderer": "catalog:",
    "ts-node": "catalog:",
    "typedoc": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "expo": ">=46.0.9",
    "react": "*",
    "react-native": ">=0.75.0",
    "react-native-webview": "*"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    },
    "react-native-webview": {
      "optional": true
    }
  },
  "jest": {
    "preset": "react-native",
    "setupFilesAfterEnv": [
      "<rootDir>/jest/setup.js"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/",
      "<rootDir>/e2e"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/packages/",
      "<rootDir>/tooling/",
      "<rootDir>/examples/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|react-native-webview)/)"
    ],
    "moduleNameMapper": {
      "^.+/package\\.json$": "<rootDir>/package.json"
    }
  },
  "eslintConfig": {
    "extends": [
      "@react-native",
      "plugin:prettier/recommended"
    ],
    "plugins": [
      "import"
    ],
    "settings": {
      "import/resolver": {
        "node": {
          "extensions": [
            ".js",
            ".jsx",
            ".ts",
            ".tsx",
            ".json"
          ]
        }
      }
    },
    "rules": {
      "import/no-relative-packages": "error",
      "no-shadow": "off",
      "@typescript-eslint/no-shadow": [
        "error"
      ],
      "no-restricted-syntax": [
        "error",
        {
          "selector": "TSEnumDeclaration[const=true]",
          "message": "`const enum` declarations are not allowed"
        }
      ],
      "@react-native/no-deep-imports": "off"
    },
    "overrides": [
      {
        "files": [
          "src/**",
          "packages/**",
          "tooling/**",
          "examples/**"
        ],
        "rules": {
          "no-restricted-imports": [
            "error",
            {
              "patterns": [
                {
                  "group": [
                    "@stripe/*/src",
                    "@stripe/*/src/**",
                    "@stripe/*/lib",
                    "@stripe/*/lib/**"
                  ],
                  "message": "Import other packages through their public entry points."
                }
              ]
            }
          ]
        }
      },
      {
        "files": [
          "example/**"
        ],
        "rules": {
          "no-restricted-imports": [
            "error",
            {
              "patterns": [
                {
                  "group": [
                    "@stripe/react-native-*/src",
                    "@stripe/react-native-*/src/**",
                    "@stripe/react-native-*/lib",
                    "@stripe/react-native-*/lib/**"
                  ],
                  "message": "Import other packages through their public entry points."
                }
              ]
            }
          ]
        }
      }
    ]
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/",
    "dist/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "configFile": true
        }
      ],
      [
        "module",
        {
          "configFile": true
        }
      ],
      "typescript"
    ]
  },
  "lint-staged": {
    "*.{js,ts,tsx}": "eslint --ignore-path .gitignore",
    "*.{ts,tsx}": "bash -c 'yarn typescript'",
    "*.kt": "bash -c 'yarn format:android:write'",
    "*.swift": "bash -c 'yarn format:ios:write'"
  },
  "resolutions": {
    "simple-plist": "1.3.1"
  },
  "codegenConfig": {
    "android": {
      "javaPackageName": "com.reactnativestripesdk"
    },
    "ios": {
      "componentProvider": {
        "ApplePayButton": "ApplePayButtonComponentView",
        "AddToWalletButton": "AddToWalletButtonComponentView",
        "AddressSheetView": "AddressSheetViewComponentView",
        "AuBECSDebitForm": "AuBECSDebitFormComponentView",
        "CardField": "CardFieldComponentView",
        "CardForm": "CardFormComponentView",
        "EmbeddedPaymentElementView": "EmbeddedPaymentElementViewComponentView",
        "PaymentMethodMessagingElementView": "PaymentMethodMessagingElementViewComponentView",
        "CheckoutPaymentElementView": "CheckoutPaymentElementViewComponentView",
        "CheckoutCurrencySelectorElementView": "CheckoutCurrencySelectorElementViewComponentView",
        "NavigationBar": "NavigationBarComponentView",
        "StripeContainer": "StripeContainerComponentView"
      }
    },
    "name": "rnstripe",
    "type": "all",
    "jsSrcsDir": "./src/specs"
  },
  "nx": {
    "includedScripts": [
      "build",
      "typecheck",
      "lint",
      "test",
      "pack"
    ]
  },
  "packageManager": "yarn@4.14.1"
}
